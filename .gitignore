# Ignore everything by default
/*

# Keep this .gitignore
!/.gitignore

# Keep these top-level folders and all their contents
!/include/
!/include/**

!/input/
!/input/**

!/output/
/output/**

!/src/
!/src/**

# Keep run script and Makefile variants at repo root
!/run.sh
!/Makefile
!/makefile
!/Makefiles

# Keep any Markdown files anywhere
!**/*.md

# Ignore the repository-level Instructions.md specifically
# (override the previous keep rule)
/Instructions.md
Instructions.md

# Optional: keep .gitattributes if present
!/.gitattributes

# Explicitly ignore srcv2
/srcv2/
/srcv2/**

# End of .gitignore
